# Supabase（Googleログイン用）。ダッシュボードの Project Settings → API から取得する。
# anon キーはブラウザに公開される前提のキー。service_role キーは絶対にここへ入れない。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# バックエンドのURL（/api をここへ中継する）。デプロイ時に設定する。未設定なら http://127.0.0.1:8000（手元のバックエンド）。
# 例: BACKEND_URL=https://xxxx.onrender.com
BACKEND_URL=
